@page
@using AngryCatalogEditor.GUI.IO
@using Newtonsoft.Json
@model AngryCatalogEditor.GUI.Pages.ModifyBundleModel
@{
    var guid = Request.Query["guid"];
    AngryCatalogHandler.TryGetCatalog(out LevelCatalog catalog);
    var bundle = catalog.Levels.Where(l => l.Guid == guid).First();
}

<style>

    .level_thumbnail {
        aspect-ratio: 4/3;
        background-image: url(/CatalogApi?handler=Thumbnail&guid=@Html.Raw(guid));
        background-size: cover;
    }

    .level_thumbnail_img {
        width: 100%;
        height: 100%;
        background-size: cover;
    }

    .level_thumbnail_upload_img {
        height: 80%;
        width: auto;
        aspect-ratio: 1/1;
    }

    .form_row {
        justify-content: left;
        width: 100%;
        display: flex;
        gap: 5px;
    }

    .form_column {
        justify-content: left;
        display: grid;
        grid-template-columns: auto 1fr;
        grid-template-rows: repeat(3, min-content);
        width: 100%;
        height: auto;
        gap: 5px;
    }

    .form_input {
        display: flex;
        width: 100%;
        height: min-content;
    }

    .form_grid_item {
        justify-content: left;
        display: flex;
        height: min-content;
    }

</style>

<div class="text-center" style="display:flex; flex-direction:column; gap:5px;">
    @Html.AntiForgeryToken()

    <!-- LEVEL INFO -->
    <div class="card">
        <div style="display: flex; flex-direction: row;">
            <h1 style="flex: 1; text-align: left; font-weight: bold;">Update Level Information</h1>
            <button id="delete_bundle" class="danger" style="margin-top: 5px; margin-bottom: 5px;" onclick="deleteBundle()">Delete Bundle</button>
        </div>

        <div style="justify-content: center; display: flex;">
            <div class="form_row">

                <div style="display: flex; flex-direction: column; width: 25%; gap: 5px;">
                    <div class="level_thumbnail" id="level_thumbnail">
                        <div class="level_thumbnail_img" id="level_thumbnail_img">
                        </div>
                    </div>

                    <div style="display: flex; gap: 5px;">
                        <button class="accept" style="flex: 1;" onclick="openThumbnail()">Modify Thumbnail</button>
                        <button class="danger" style="flex: 1;" onclick="resetThumbnail()">Reset Thumbnail</button>
                    </div>
                </div>

                <div class="form_column">
                    <div class="form_grid_item">
                        Level name:
                    </div>
                    <div class="form_grid_item" style="gap: 5px;">
                        <input class="form_input" name="level_name" id="level_name" value="@Html.Raw(bundle.Name)" disabled="disabled" />
                        <button class="accept" onclick="modifyBundleName()">Modify</button>
                        <button class="danger" onclick="resetBundleName()">Reset</button>
                    </div>
                    <div class="form_grid_item">
                        Author:
                    </div>
                    <div class="form_grid_item" style="gap: 5px;">
                        <input class="form_input" name="author" id="author" value="@Html.Raw(bundle.Author)" disabled="disabled" />
                        <button class="accept" onclick="modifyAuthor()">Modify</button>
                        <button class="danger" onclick="resetAuthor()">Reset</button>
                    </div>
                    <div class="form_grid_item">
                        Locked:
                    </div>
                    <div class="form_grid_item" style="height: 100%;">
                        <input id="locked" type="checkbox" @Html.Raw(bundle.Locked ? "Checked" : "") />
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- EXTERNAL LINKS -->
    <div class="card">
        <h1 style="width: 100%; text-align: left; font-weight: bold;">Update External Links</h1>

        <div style="display:flex; width: 100%; height: min-content; gap: 5px;">
            <div>GitHub link to first file: </div>
            <input name="external_link_first" id="external_link_first" style="display: flex; flex: 1;" />
            <button class="accept" type="button" id="fetch_external_links" onclick="getExternalLinks()">Fetch files</button>
            <button class="danger" id="reset_external_links" onclick="resetExternalLinks()">Reset</button>
        </div>

        <div id="external_link_out" style="text-align: left">
            <!-- Generated from code -->
        </div>
    </div>

    <!-- ANGRY FILE -->
    <div class="card" style="gap: 10px;">
        <h1 style="width: 100%; text-align: left; font-weight: bold;">Update Angry File</h1>

        <div class="form_row">
            <button class="accept" style="flex: 1; padding-top: 10px; padding-bottom: 10px;" type="button" onclick="openAngryFile()">Select new Angry file</button>
            <button class="danger" style="flex: 1;" onclick="resetAngryFile()">Reset</button>
        </div>

        <textarea class="form_input" name="changelog" id="changelog" style="width: 100%" placeholder="Changelog"></textarea>

        <div id="level_info" style="text-align: left; display: none;">
            <div class="form_row" style="gap: 10px;">
                <div id="bundle_thumbnail" style="width: 20%; aspect-ratio: 1; align-self: flex-start; background-size: cover;"></div>
                <div style="text-align: left; font-size: 18px;">
                    <h1 id="bundle_name">Bundle Name</h1><br><p id="bundle_summary">Author: ???</p>
                </div>
            </div>

            <hr />
            <h1 style="text-decoration-line: underline;">Levels</h1>

            <div id="level_container" style="gap: 10px;">
                <!-- Generated from code -->
            </div>
        </div>
    </div>

    <!-- CHANGELOG -->
    <div class="card" style="display: flex; gap: 10px;">
        <details>
            <summary style="width: 100%; text-align: left; font-weight: bold; font-size: 2.5rem; margin-bottom: 5px;">Changelog History</summary>
            <div id="changelog_container" style="gap: 5px; display: flex; flex-direction: column;">
                <!-- GENERATED BY CODE -->
            </div>
        </details>
    </div>

    <!-- CHANGES -->
    <div class="card" style="gap: 10px; border-color: greenyellow; background-color: lightyellow;">
        <h1 style="width: 100%; text-align: left; font-weight: bold;">Changes</h1>
        <div id="changes_info" style="text-align: left;">
            No pending changes
        </div>
    </div>

    <!-- SUBMIT -->
    <button type="button" onclick="modifyAngryFile()" class="accept" style="width: 100%; padding-top: 10px; padding-bottom: 10px;">Modify Bundle</button>

    <template id="level_info_template">
        <div id="level_info_inst" class="form_row" style="margin-bottom: 10px">
            <div id="level_info_thumbnail" style="width: 20%; aspect-ratio: 4/3; align-self: flex-start; background-size: cover;"></div>
            <div style="text-align: left; flex: 1;">
                <h2 id="level_info_name">Level Name</h2><hr />
                <p id="level_info_summary"></p>
            </div>
        </div>
    </template>

    <template id="changelog_temp">
        <div id="changelog_inst" class="card" style="border-color: lightgray; display: flex; flex-direction: column; text-align: left; gap: 5px;">
            <span><span id="changelog_name"></span><button id="changelog_reset" class="danger">Reset</button></span>
            <textarea id="changelog_text"></textarea>
        </div>
    </template>
</div>

<script>
    const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
    var randomId = Math.floor(Math.random() * 1000000);

    // Fields
    const levelThumbnailImg = document.getElementById('level_thumbnail_img');
    const levelNameField = document.getElementById('level_name');
    const authorField = document.getElementById('author');
    const lockedField = document.getElementById('locked');
    var changelogTextFields = []

    var levelNameModified = false;
    var authorModified = false;
    var lockedModified = false;
    var thumbnailModified = false;
    var angryFileModified = false;
    var externalUrlsModified = false;
    var newExternalUrls = [];
    var changelogModified = @Html.Raw(JsonConvert.SerializeObject(bundle.Updates.Select(u => false).ToArray()));

    const originalBundleName = @Html.Raw(JsonConvert.SerializeObject(bundle.Name));
    const originalAuthor = @Html.Raw(JsonConvert.SerializeObject(bundle.Author));
    const originalLocked = @Html.Raw(JsonConvert.SerializeObject(bundle.Locked));
    const originalChangelog = @Html.Raw(JsonConvert.SerializeObject(bundle.Updates.Select(u => u.Message).ToArray()));
    const originalChangelogDates = @Html.Raw(JsonConvert.SerializeObject(bundle.Updates.Select(u => u.Date).ToArray()));

    const levelTemplate = document.getElementById('level_info_template');
    const changelogTemplate = document.getElementById('changelog_temp');

    // Thumbnail

    async function openThumbnail() {
        const response = await fetch('/ModifyBundle?handler=OpenThumbnail', {
            method: 'post',
            headers: {
                'Content-Type': 'image/png',
                'RequestVerificationToken': antiForgeryToken,
            }
        });

        if (response.status != 200) {
            if (response.status == 400)
                alert('Error! See console.');

            return;
        }

        const blob = await response.blob();
        const imgUrl = URL.createObjectURL(blob);
        levelThumbnailImg.style.backgroundImage = `url(${imgUrl})`;

        thumbnailModified = true;
        updateChanges();
    }

    function resetThumbnail()
    {
        thumbnailModified = false;
        levelThumbnailImg.style.backgroundImage = 'none';

        updateChanges();
    }

    // Bundle name

    function modifyBundleName()
    {
        const originalName = '@Html.Raw(bundle.Name)';
        const newName = prompt('Enter new bundle name', levelNameField.value);

        levelNameModified = originalName != newName;
        levelNameField.value = newName;

        updateChanges();
    }

    function resetBundleName()
    {
        const originalName = '@Html.Raw(bundle.Name)';

        levelNameField.value = originalName;
        levelNameModified = false;

        updateChanges();
    }

    // Author

    function modifyAuthor()
    {
        const originalAuthor = '@Html.Raw(bundle.Author)';
        const newName = prompt('Enter new author name', authorField.value);

        authorModified = originalAuthor != newName;
        authorField.value = newName;

        updateChanges();
    }

    function resetAuthor()
    {
        const originalAuthor = '@Html.Raw(bundle.Name)';

        authorField.value = originalAuthor;
        authorModified = false;

        updateChanges();
    }

    // External links

    async function getExternalLinks() {
        const fetchButton = document.getElementById("fetch_external_links");
        const resetButton = document.getElementById("reset_external_links");
        const urlInput = document.getElementById("external_link_first");

        try {
            fetchButton.disabled = true;
            resetButton.disabled = true;
            urlInput.disabled = true;

            // Parse given github url; extract repository name, owner, branch, file path
            const githubRegex = /(https?:\/\/)?(www.)?github.com\/([^\/]+)\/([^\/]+)\/blob\/([^\/]+)\/(.*\.angry\d*)/;
            const result = urlInput.value.match(githubRegex)

            if (result == null) {
                alert("Given URL is not valid! Enter url to the first file.");
                return;
            }

            const repoOwner = result[3];
            const repoName = result[4];
            const repoBranch = result[5];
            const firstFilePath = result[6];
            const folderPath = firstFilePath.substring(0, firstFilePath.lastIndexOf('/'));
            const fileNameWithExt = firstFilePath.substring(firstFilePath.lastIndexOf('/') + 1);
            const fileName = fileNameWithExt.substring(0, fileNameWithExt.lastIndexOf('.'));

            const repoInfoUrl = `https://api.github.com/repos/${repoOwner}/${repoName}/branches/${repoBranch}`;
            const folderRequestUrl = `https://api.github.com/repos/${repoOwner}/${repoName}/contents/${folderPath}?ref=${repoBranch}`;

            // Get given branch's latest commit SHA
            console.log(`Making request to ${repoInfoUrl}`);
            const repoReq = await fetch(repoInfoUrl, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            if (!repoReq.ok) {
                alert(`Failed to make request to GitHub API! Status code ${repoReq.status}: ${repoReq.statusText}`);
                return;
            }

            const sha = JSON.parse(await repoReq.text()).commit.sha
            if (sha == null || sha == undefined) {
                alert('Failed to fetch repo SHA!');
                return;
            }

            externalUrlsModified = true;

            if (fileNameWithExt.endsWith('.angry')) {
                // This is a single file
                newExternalUrls = [ `https://raw.githubusercontent.com/${repoOwner}/${repoName}/${sha}/${firstFilePath}` ];
            }
            else {
                // Get all the files inside the folder of the first angry file
                console.log(`Making request to ${folderRequestUrl}`);
                const req = await fetch(folderRequestUrl, {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                if (!req.ok) {
                    alert(`Failed to make request to GitHub API! Status code ${req.status}: ${req.statusText}`);
                    return;
                }

                const resp = JSON.parse(await req.text());

                // Filter out other files/folders, map each parted file to its raw url
                const partedFiles = resp
                    .filter(e => e.type == 'file')
                    .filter(e => e.name.startsWith(fileName + '.'))
                    .map(e => e.download_url.replace(`/${repoOwner}/${repoName}/${repoBranch}/`, `/${repoOwner}/${repoName}/${sha}/`));

                // Use numeric sort instead of lexicographic sort
                partedFiles.sort((e1, e2) => Number(e1.substring(e1.lastIndexOf('.') + 6)) > Number(e2.substring(e2.lastIndexOf('.') + 6)))
                console.log(partedFiles);

                newExternalUrls = partedFiles;
            }

            // Print out the result
            const ownerUrl = `https://github.com/${repoOwner}`;
            const repoUrl = `https://github.com/${repoOwner}/${repoName}`;

            if (fileNameWithExt.endsWith('.angry')) {
                document.getElementById('external_link_out').innerHTML
                    = '<br>Success!<br>'
                    + `Repository owner : <a href="${ownerUrl}">${repoOwner}</a><br>`
                    + `Repository URL : <a href="${repoUrl}">${repoName}</a><br>`
                    + 'Type : Single file<br>'
                    + `Link : <a href="${(newExternalUrls[0])}">${(newExternalUrls[0])}</a>`
            }
            else {
                document.getElementById('external_link_out').innerHTML
                    = '<br>Success!<br>'
                    + `Repository owner : <a href="${ownerUrl}">${repoOwner}</a><br>`
                    + `Repository URL : <a href="${repoUrl}">${repoName}</a><br>`
                    + 'Type : Parted file<br>'
                    + `# of parted files : ${(newExternalUrls.length)}<br><br>`
                    + 'Links : <br>'
                    + newExternalUrls.map(e => `(Part ${e.substring(e.lastIndexOf('angry') + 5)}) <a href="${e}">${e}</a>`).join('<br>');
            }
        }
        finally {
            fetchButton.disabled = false;
            resetButton.disabled = false;
            urlInput.disabled = false;
        }

        updateChanges();
    }

    function resetExternalLinks()
    {
        externalUrlsModified = false;
        document.getElementById('external_link_out').innerHTML = '';

        updateChanges();
    }

    // Angry file

    async function openAngryFile() {
        const response = await fetch('/ModifyBundle?handler=OpenAngryFile&guid=@Html.Raw(guid)', {
            method: 'post',
            headers: {
                'RequestVerificationToken': antiForgeryToken,
            }
        });

        if (response.status != 200) {
            if (response.status == 400)
                alert(await response.text());

            return;
        }

        const bundleInfo = JSON.parse(await response.text());
        console.log(bundleInfo);

        document.getElementById("bundle_name").innerHTML = bundleInfo.Name;
        document.getElementById("bundle_summary").innerHTML
         = `Author: ${bundleInfo.Author}<br>`
         + `Global ID: ${bundleInfo.Guid}<br>`
         + `Build hash: ${bundleInfo.Hash}`;
        document.getElementById("bundle_thumbnail").style.backgroundImage = `url('/ModifyBundle?handler=BundleThumbnail&random=${randomId++}')`;
        document.getElementById("level_info").style.display = '';

        const levelContainer = document.getElementById('level_container');

        levelContainer.innerHTML = '';

        bundleInfo.Levels.forEach(level => {
            const item = document.importNode(levelTemplate.content, true);
            const root = item.querySelector('#level_info_inst');
            const thumbnail = item.querySelector('#level_info_thumbnail');
            const name = item.querySelector('#level_info_name');
            const summary = item.querySelector('#level_info_summary');

            name.innerHTML = level.LevelName;
            summary.innerHTML
             = `Is secret level: ` + (level.isSecretLevel ? 'Yes' : 'No') + '<br>'
             + `Challenge: ` + (level.levelChallengeEnabled ? level.levelChallengeText : 'Disabled') + '<br>'
             + `Number of secrets: ${level.secretCount}`;
            thumbnail.style.backgroundImage = `url('/ModifyBundle?handler=LevelThumbnail&id=${level.LevelId}')`;

            levelContainer.appendChild(item);
        });

        angryFileModified = true;
        updateChanges();
    }

    function resetAngryFile()
    {
        angryFileModified = false;

        document.getElementById("level_info").style.display = 'none';
        const levelContainer = document.getElementById('level_container');
        levelContainer.innerHTML = '';

        updateChanges();
    }

    // Changelog

    function createChangelogHistory() {
        const changelogContainer = document.getElementById('changelog_container');

        for (var i = 0; i < originalChangelog.length; i++) {
            const item = document.importNode(changelogTemplate.content, true);
            const changelogName = item.querySelector('#changelog_name');
            const changelogReset = item.querySelector('#changelog_reset');
            const changelogText = item.querySelector('#changelog_text');

            changelogName.innerText = `Update ${i + 1} (${new Date(originalChangelogDates[i] * 1000).toLocaleString('EN')}) `
            changelogText.value = originalChangelog[i];

            const changelogIndex = i;

            changelogText.onchange = () => {
                changelogModified[changelogIndex] = changelogText.value != originalChangelog[changelogIndex];
                updateChanges();
            };

            changelogReset.onclick = () => {
                changelogModified[changelogIndex] = false;
                changelogText.value = originalChangelog[changelogIndex];
                updateChanges();
            };

            changelogTextFields.push(changelogText);
            changelogContainer.appendChild(item);
        }
    }

    // Changes

    function updateChanges()
    {
        const changesText = document.getElementById('changes_info');
        const levelNameField = document.getElementById('level_name');
        const authorField = document.getElementById('author');

        var result = '';

        if (levelNameModified)
            result += `<li>Bundle name: <span style="color: red; text-decoration: line-through;">@Html.Raw(bundle.Name)</span> <span style="color: green;">${levelNameField.value}</span></li>`;
        
        if (authorModified)
           result += `<li>Author: <span style="color: red; text-decoration: line-through;">@Html.Raw(bundle.Author)</span> <span style="color: green;">${authorField.value}</span></li>`;

        if (lockedModified)
            result += `<li>Locked: <span style="color: red; text-decoration: line-through;">@Html.Raw(bundle.Locked ? "Yes" : "No")</span> <span style="color: green;">${lockedField.checked ? "Yes" : "No"}</span></li>`;

        if (thumbnailModified)
           result += `<li>Updated online thumbnail</li>`

        if (angryFileModified)
           result += `<li>Updated Angry file</li>`

        if (externalUrlsModified)
           result += `<li>Updated external URLs</li>`

        for (let i = 0; i < changelogModified.length; i++) {
            if (!changelogModified[i]) continue;
            result += `<li>Modified changelog of update ${i + 1} </li>`
        }

        if (result == '')
            changesText.innerHTML = "No changes";
        else
            changesText.innerHTML = `<ul>${result}</ul>`;
    }

    // Submit

    async function modifyAngryFile() {

        const madeChanges = thumbnailModified || levelNameModified || authorModified || lockedModified || externalUrlsModified || angryFileModified || changelogModified.reduce((e, a) => e || a);

        if (!madeChanges) {
            alert('There are no changes to apply');
            return;
        }

        if (angryFileModified && !externalUrlsModified)
        {
            alert('New external URLs must be provided when updating the angry file');
            return;
        }

        const changelogText = document.getElementById('changelog').value;

        if (angryFileModified && changelogText.trim() == '')
        {
            alert('Changelog must be provided when updating the angry file');
            return;
        }

        const resp = await fetch(`/ModifyBundle?handler=ModifyBundle`, {
            method: 'post',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': antiForgeryToken,
            },
            body: JSON.stringify({
                guid: @Html.Raw(JsonConvert.SerializeObject(bundle.Guid)),

                updateThumbnail: thumbnailModified,
                newBundleName: levelNameModified ? levelNameField.value : null,
                newBundleAuthor: authorModified ? authorField.value : null,
                newLocked: lockedModified ? lockedField.checked : null,

                updateExternalURLs: externalUrlsModified,
                newExternalURLs: externalUrlsModified ? newExternalUrls : null,

                updateAngryFile: angryFileModified,
                changelog: angryFileModified ? changelogText : null,

                updateChangelog: changelogModified,
                newChangelogText: changelogTextFields.map((c, i) => changelogModified[i] ? c.value : null)
            })
        });

        if (!resp.ok) {
            alert(await resp.text());
            return;
        }

        alert('Modified the bundle successfully');
        location.replace('/Changes')
    }

    async function deleteBundle() {
        if (!confirm('Would you like to remove this bundle from the online catalog?'))
            return;

        const req = await fetch('/ModifyBundle?handler=DeleteBundle&guid=@Html.Raw(guid)', {
            method: 'post',
            headers: {
                'RequestVerificationToken': antiForgeryToken,
            }
        });

        if (!req.ok) {
            alert(await req.text());
            return;
        }

        alert('Removed bundle successfully');
        location.replace('/Changes')
    }

    createChangelogHistory();

    lockedField.onclick = () => {
        lockedModified = lockedField.checked != originalLocked;
        updateChanges();
    };
</script>
