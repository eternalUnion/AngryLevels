@page
@model AngryCatalogEditor.GUI.Pages.AngryCombinerModel
@{
}

<div class="text-center">
    <div class="card" style="gap: 5px;">
        <h1 style="width: 100%; text-align: left; font-weight: bold;">External Links</h1>

        <div style="display:flex; width: 100%; height: min-content; gap: 5px;">
            <div>GitHub link to first file: </div>
            <input name="external_link_first" id="external_link_first" style="display: flex; flex: 1;" />
            <button class="accept" type="button" id="fetch_external_links" onclick="getExternalLinks()">Fetch files</button>
        </div>

        <button id="download" class="accept" style="flex: 1; padding-top: 5px; padding-bottom: 5px;" disabled onclick="downloadAngryFile()">Download</button>

        <div id="external_link_out" style="text-align: left">
            <!-- Generated from code -->
        </div>
    </div>
</div>

<script>
    var external_urls = [];

    const fetchButton = document.getElementById("fetch_external_links");
    const downloadButton = document.getElementById("download");
    const urlInput = document.getElementById("external_link_first");

    downloadButton.disabled = true;

    async function getExternalLinks() {
        try {
            fetchButton.disabled = true;
            downloadButton.disabled = true;
            urlInput.disabled = true;

            // Parse given github url; extract repository name, owner, branch, file path
            const githubRegex = /(https?:\/\/)?(www.)?github.com\/([^\/]+)\/([^\/]+)\/blob\/([^\/]+)\/(.*\.angry\d*)/;
            const result = urlInput.value.match(githubRegex)

            if (result == null) {
                alert("Given URL is not valid! Enter url to the first file.");
                return;
            }

            const repoOwner = result[3];
            const repoName = result[4];
            const repoBranch = result[5];
            const firstFilePath = result[6];
            const folderPath = firstFilePath.substring(0, firstFilePath.lastIndexOf('/'));
            const fileNameWithExt = decodeURIComponent(firstFilePath.substring(firstFilePath.lastIndexOf('/') + 1));
            const fileName = fileNameWithExt.substring(0, fileNameWithExt.lastIndexOf('.'));

            const repoInfoUrl = `https://api.github.com/repos/${repoOwner}/${repoName}/branches/${repoBranch}`;
            const folderRequestUrl = `https://api.github.com/repos/${repoOwner}/${repoName}/contents/${folderPath}?ref=${repoBranch}`;

            // Get given branch's latest commit SHA
            console.log(`Making request to ${repoInfoUrl}`);
            const repoReq = await fetch(repoInfoUrl, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            if (!repoReq.ok) {
                alert(`Failed to make request to GitHub API! Status code ${repoReq.status}: ${repoReq.statusText}`);
                return;
            }

            const sha = JSON.parse(await repoReq.text()).commit.sha
            if (sha == null || sha == undefined) {
                alert('Failed to fetch repo SHA!');
                return;
            }

            if (fileNameWithExt.endsWith('.angry')) {
                // This is a single file
                external_urls = [ `https://raw.githubusercontent.com/${repoOwner}/${repoName}/${sha}/${firstFilePath}` ];
            }
            else {
                // Get all the files inside the folder of the first angry file
                console.log(`Making request to ${folderRequestUrl}`);
                const req = await fetch(folderRequestUrl, {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                if (!req.ok) {
                    alert(`Failed to make request to GitHub API! Status code ${req.status}: ${req.statusText}`);
                    return;
                }

                const resp = JSON.parse(await req.text());

                // Filter out other files/folders, map each parted file to its raw url
                const partedFiles = resp
                    .filter(e => e.type == 'file')
                    .filter(e => e.name.startsWith(fileName + '.'))
                    .map(e => e.download_url.replace(`/${repoOwner}/${repoName}/${repoBranch}/`, `/${repoOwner}/${repoName}/${sha}/`));

                // Use numeric sort instead of lexicographic sort
                partedFiles.sort((e1, e2) => Number(e1.substring(e1.lastIndexOf('.') + 6)) > Number(e2.substring(e2.lastIndexOf('.') + 6)))
                console.log(partedFiles);

                external_urls = partedFiles;
            }


            // Print out the result
            const ownerUrl = `https://github.com/${repoOwner}`;
            const repoUrl = `https://github.com/${repoOwner}/${repoName}`;

            if (fileNameWithExt.endsWith('.angry')) {
                document.getElementById('external_link_out').innerHTML
                    = '<br>Success!<br>'
                    + `Repository owner : <a href="${ownerUrl}">${repoOwner}</a><br>`
                    + `Repository URL : <a href="${repoUrl}">${repoName}</a><br>`
                    + 'Type : Single file<br>'
                    + `Link : <a href="${(external_urls[0])}">${(external_urls[0])}</a>`
            }
            else {
                document.getElementById('external_link_out').innerHTML
                    = '<br>Success!<br>'
                    + `Repository owner : <a href="${ownerUrl}">${repoOwner}</a><br>`
                    + `Repository URL : <a href="${repoUrl}">${repoName}</a><br>`
                    + 'Type : Parted file<br>'
                    + `# of parted files : ${(external_urls.length)}<br><br>`
                    + 'Links : <br>'
                    + external_urls.map(e => `(Part ${e.substring(e.lastIndexOf('angry') + 5)}) <a href="${e}">${e}</a>`).join('<br>');
            }
        }
        finally {
            fetchButton.disabled = false;
            urlInput.disabled = false;

            downloadButton.disabled = external_urls.length === 0;
        }
    }

    async function downloadAngryFile() {
        if (external_urls.length == 0)
            return;

        window.open('/AngryCombiner?handler=Download&urls=' + encodeURIComponent(JSON.stringify(external_urls)), '_blank');
    }
</script>
