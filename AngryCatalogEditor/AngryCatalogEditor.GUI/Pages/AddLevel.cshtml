@page
@model AngryCatalogEditor.GUI.Pages.AddLevelModel
@{
    ViewData["Title"] = "Add level";
}

<style>

    .level_thumbnail {
        width: 25%;
        aspect-ratio: 4/3;
        align-self: flex-start;
        background-image: url("images/no_thumbnail.png");
        background-size: cover;
    }

    .level_thumbnail_img {
        width: 100%;
        height: 100%;
        background-size: cover;
    }

    .level_thumbnail_upload {
        width: 100%;
        height: 100%;
        opacity: 0;
        background-color: rgba(100,100,100,0.5);
    }

    .level_thumbnail_upload:hover {
        transition: opacity 0.2s ease;
        opacity: 1;
    }

    .level_thumbnail_upload_img {
        height: 80%;
        width: auto;
        aspect-ratio: 1/1;
    }

    .form_row {
        justify-content: left;
        width: 100%;
        display: flex;
        gap: 5px;
    }

    .form_column {
        justify-content: left;
        display: grid;
        grid-template-columns: auto 1fr;
        grid-template-rows: repeat(3, min-content);
        width: 100%;
        height: auto;
        gap: 5px;
    }

    .form_input {
        display: flex;
        width: 100%;
        height: min-content;
    }

    .form_grid_item {
        justify-content: left;
        display: flex;
        height: min-content;
    }

</style>

<script>
    var external_urls = [];
    var thumbnailChosen = false;
    var angryFileChosen = false;

    async function openThumbnail() {
        const response = await fetch('/AddLevel?handler=OpenThumbnail', {
            method: 'POST',
            headers: {
                'Content-Type': 'image/png',
            }
        });

        if (response.status != 200) {
            if (response.status == 400)
                alert('Error! See console.');

            return;
        }

        const blob = await response.blob();
        const imgUrl = URL.createObjectURL(blob);
        const obj = document.getElementById('level_thumbnail_img');
        obj.style.backgroundImage = `url(${imgUrl})`;

        thumbnailChosen = true;
    }

    async function getExternalLinks() {
        const fetchButton = document.getElementById("fetch_external_links");
        const urlInput = document.getElementById("external_link_first");

        try {
            fetchButton.disabled = true;
            urlInput.disabled = true;

            // Parse given github url; extract repository name, owner, branch, file path
            const githubRegex = /(https?:\/\/)?(www.)?github.com\/([^\/]+)\/([^\/]+)\/blob\/([^\/]+)\/(.*\.angry\d*)/;
            const result = urlInput.value.match(githubRegex)

            if (result == null) {
                alert("Given URL is not valid! Enter url to the first file.");
                return;
            }

            const repoOwner = result[3];
            const repoName = result[4];
            const repoBranch = result[5];
            const firstFilePath = result[6];
            const folderPath = firstFilePath.substring(0, firstFilePath.lastIndexOf('/'));
            const fileNameWithExt = firstFilePath.substring(firstFilePath.lastIndexOf('/') + 1);
            const fileName = fileNameWithExt.substring(0, fileNameWithExt.lastIndexOf('.'));

            const repoInfoUrl = `https://api.github.com/repos/${repoOwner}/${repoName}/branches/${repoBranch}`;
            const folderRequestUrl = `https://api.github.com/repos/${repoOwner}/${repoName}/contents/${folderPath}?ref=${repoBranch}`;

            // Get given branch's latest commit SHA
            console.log(`Making request to ${repoInfoUrl}`);
            const repoReq = await fetch(repoInfoUrl, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            if (!repoReq.ok) {
                alert(`Failed to make request to GitHub API! Status code ${repoReq.status}: ${repoReq.statusText}`);
                return;
            }

            const sha = JSON.parse(await repoReq.text()).commit.sha
            if (sha == null || sha == undefined) {
                alert('Failed to fetch repo SHA!');
                return;
            }

            if (fileNameWithExt.endsWith('.angry')) {
                // This is a single file
                external_urls = [ `https://raw.githubusercontent.com/${repoOwner}/${repoName}/${sha}/${firstFilePath}` ];
            }
            else {
                // Get all the files inside the folder of the first angry file
                console.log(`Making request to ${folderRequestUrl}`);
                const req = await fetch(folderRequestUrl, {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                if (!req.ok) {
                    alert(`Failed to make request to GitHub API! Status code ${req.status}: ${req.statusText}`);
                    return;
                }

                const resp = JSON.parse(await req.text());

                // Filter out other files/folders, map each parted file to its raw url
                const partedFiles = resp
                    .filter(e => e.type == 'file')
                    .filter(e => e.name.startsWith(fileName + '.'))
                    .map(e => e.download_url.replace(`/${repoOwner}/${repoName}/${repoBranch}/`, `/${repoOwner}/${repoName}/${sha}/`));

                // Use numeric sort instead of lexicographic sort
                partedFiles.sort((e1, e2) => Number(e1.substring(e1.lastIndexOf('.') + 6)) > Number(e2.substring(e2.lastIndexOf('.') + 6)))
                console.log(partedFiles);

                external_urls = partedFiles;
            }


            // Print out the result
            const ownerUrl = `https://github.com/${repoOwner}`;
            const repoUrl = `https://github.com/${repoOwner}/${repoName}`;

            if (fileNameWithExt.endsWith('.angry')) {
                document.getElementById('external_link_out').innerHTML
                    = '<br>Success!<br>'
                    + `Repository owner : <a href="${ownerUrl}">${repoOwner}</a><br>`
                    + `Repository URL : <a href="${repoUrl}">${repoName}</a><br>`
                    + 'Type : Single file<br>'
                    + `Link : <a href="${(external_urls[0])}">${(external_urls[0])}</a>`
            }
            else {
                document.getElementById('external_link_out').innerHTML
                    = '<br>Success!<br>'
                    + `Repository owner : <a href="${ownerUrl}">${repoOwner}</a><br>`
                    + `Repository URL : <a href="${repoUrl}">${repoName}</a><br>`
                    + 'Type : Parted file<br>'
                    + `# of parted files : ${(external_urls.length)}<br>`
                    + 'Links : <br><br>'
                    + external_urls.map(e => `(Part ${e.substring(e.lastIndexOf('angry') + 5)}) <a href="${e}">${e}</a>`).join('<br>');
            }
        }
        finally {
            fetchButton.disabled = false;
            urlInput.disabled = false;
        }
    }

    async function openAngryFile() {
        const response = await fetch('/AddLevel?handler=OpenAngryFile', {
            method: 'POST'
        });

        if (response.status != 200) {
            if (response.status == 400)
                alert(await response.text());

            return;
        }

        const bundleInfo = JSON.parse(await response.text());
        console.log(bundleInfo);

        document.getElementById("bundle_name").innerHTML = bundleInfo.Name;
        document.getElementById("bundle_summary").innerHTML
         = `Author: ${bundleInfo.Author}<br>`
         + `Global ID: ${bundleInfo.Guid}<br>`
         + `Build hash: ${bundleInfo.Hash}`;
        document.getElementById("bundle_thumbnail").style.backgroundImage = `url('/AddLevel?handler=BundleThumbnail')`;
        document.getElementById("level_info").style.display = '';

        const levelContainer = document.getElementById('level_container');
        const levelTemplate = document.getElementById('level_info_template');

        levelContainer.innerHTML = '';

        bundleInfo.Levels.forEach(level => {
            const item = document.importNode(levelTemplate.content, true);
            const root = item.querySelector('#level_info_inst');
            const thumbnail = item.querySelector('#level_info_thumbnail');
            const name = item.querySelector('#level_info_name');
            const summary = item.querySelector('#level_info_summary');

            name.innerHTML = level.LevelName;
            summary.innerHTML
             = `Is secret level: ` + (level.isSecretLevel ? 'Yes' : 'No') + '<br>'
             + `Challenge: ` + (level.levelChallengeEnabled ? level.levelChallengeText : 'Disabled') + '<br>'
             + `Number of secrets: ${level.secretCount}`;
            thumbnail.style.backgroundImage = `url('/AddLevel?handler=LevelThumbnail&id=${level.LevelId}')`;

            levelContainer.appendChild(item);
        });

        angryFileChosen = true;
    }

    async function addAngryFile() {

        if (!thumbnailChosen) {
            alert('You must choose a thumbnail');
            return;
        }

        if (!angryFileChosen) {
            alert('You must choose an angry file');
            return;
        }

        if (external_urls.length == 0) {
            alert('You must provide an external URL');
            return;
        }

        const levelName = document.getElementById('level_name');
        const author = document.getElementById('author');
        const changelog = document.getElementById('changelog');

        if (levelName.value.trim() == '') {
            alert('You must fill the bundle name field');
            return;
        }

        if (author.value.trim() == '') {
            alert('You must fill the bundle author field');
            return;
        }

        const resp = await fetch(`/AddLevel?handler=AddLevel`, {
            method: 'post',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                Name: levelName.value,
                Author: author.value,
                UpdateMessage: changelog.value,
                ExternalURLs: external_urls
            })
        });

        if (!resp.ok) {
            alert(await resp.text());
            return;
        }

        alert('Submit success');
    }
</script>

<div class="text-center">

    <form method="post" style="display:flex; flex-direction:column; gap:5px;">
        <!-- LEVEL INFO -->
        <div class="card">
            <h1 style="width: 100%; text-align: left; font-weight: bold;">Level Information</h1>

            <div style="justify-content: center; display: flex;">
                <div class="form_row">

                    <div class="level_thumbnail" id="level_thumbnail">
                        <div class="level_thumbnail_img" id="level_thumbnail_img">
                            <button id="level_thumbnail_upload" class="level_thumbnail_upload" type="button" onclick="openThumbnail()">
                                <img class="level_thumbnail_upload_img" src="images/folder.png" />
                            </button>
                        </div>
                    </div>

                    <div class="form_column">
                        <div class="form_grid_item">
                            Level name: 
                        </div>
                        <div class="form_grid_item">
                            <input class="form_input" name="level_name" id="level_name" />
                        </div>
                        <div class="form_grid_item">
                            Author: 
                        </div>
                        <div class="form_grid_item">
                            <input class="form_input" name="author" id="author" />
                        </div>
                        <div class="form_grid_item">
                            Changelog:
                        </div>
                        <div class="form_grid_item">
                            <textarea class="form_input" name="changelog" id="changelog">Initial upload.</textarea>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        
        <!-- EXTERNAL LINKS -->
        <div class="card">
            <h1 style="width: 100%; text-align: left; font-weight: bold;">External Links</h1>

            <div style="display:flex; width: 100%; height: min-content; gap: 5px;">
                <div>GitHub link to first file: </div>
                <input name="external_link_first" id="external_link_first" style="display: flex; flex: 1;" />
                <button class="accept" type="button" id="fetch_external_links" onclick="getExternalLinks()">Fetch files</button>
            </div>

            <div id="external_link_out" style="text-align: left">
                <!-- Generated from code -->
            </div>
        </div>

        <!-- ANGRY FILE -->
        <div class="card" style="gap: 10px;">
            <h1 style="width: 100%; text-align: left; font-weight: bold;">Angry File</h1>

            <div class="form_row">
                <button class="accept" style="width: 100%; padding-top: 10px; padding-bottom: 10px;" type="button" onclick="openAngryFile()">Select</button>
            </div>

            <div id="level_info" style="text-align: left; display: none;">
                <div class="form_row" style="gap: 10px;">
                    <div id="bundle_thumbnail" style="width: 20%; aspect-ratio: 1; align-self: flex-start; background-size: cover;"></div>
                    <div style="text-align: left; font-size: 18px;">
                        <h1 id="bundle_name">Bundle Name</h1><br><p id="bundle_summary">Author: ???</p>
                    </div>
                </div>
                
                <hr />
                <h1 style="text-decoration-line: underline;">Levels</h1>

                <div id="level_container" style="gap: 10px;">
                    <!-- Generated from code -->
                </div>
            </div>
        </div>

        <!-- SUBMIT -->
        <button type="button" onclick="addAngryFile()" class="accept" style="width: 100%; padding-top: 10px; padding-bottom: 10px;">Add Bundle</button>
    </form>

    <template id="level_info_template">
        <div id="level_info_inst" class="form_row" style="margin-bottom: 10px">
            <div id="level_info_thumbnail" style="width: 20%; aspect-ratio: 4/3; align-self: flex-start; background-size: cover;"></div>
            <div style="text-align: left; flex: 1;">
                <h2 id="level_info_name">Level Name</h2><hr />
                <p id="level_info_summary"></p>
            </div>
        </div>
    </template>
</div>
